{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Desk",
  "version": "0.1.0",
  "identifier": "xyz.driftwerk.desk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "backgroundColor": "#111210",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob: deskfile: http://deskfile.localhost; media-src 'self' deskfile: http://deskfile.localhost blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; frame-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/claude-plugin/": "claude-plugin/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1MDk5RjZBMzQ5OEYzRTEKUldUaDg1ZzBhcDhKQlIremc1UkJFS3drNmRXcVNrNkVDNnVQUmtualppK1M1bE5aRkxnZkxoQWsK",
      "endpoints": [
        "https://github.com/driftwerk/workforce-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
