{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Desk",
  "version": "0.1.0",
  "identifier": "xyz.driftwerk.desk",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Desk",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#111210",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:* https: wss:; img-src 'self' data: blob: http://127.0.0.1:* https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "binaries/Desk Helper",
      "binaries/Desk Agents"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "entitlements/Desk.entitlements",
      "files": {
        "Library/LaunchAgents/xyz.driftwerk.desk.helper.plist": "LaunchAgents/xyz.driftwerk.desk.helper.plist"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA1MDk5RjZBMzQ5OEYzRTEKUldUaDg1ZzBhcDhKQlIremc1UkJFS3drNmRXcVNrNkVDNnVQUmtualppK1M1bE5aRkxnZkxoQWsK",
      "endpoints": [
        "https://github.com/driftwerk/workforce-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
