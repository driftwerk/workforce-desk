{
  "modules": ["./usage.ts"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "86400"
            ],
            "timeout": 86400
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk-hook.sh",
              "10"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
