{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "machine-secret",
  "description": "Desk's own field for a machine's password or an SSH key's passphrase: its theme, being shown, and its three commands, which no other window is granted",
  "windows": [
    "machine-secret"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-settings-load",
    "allow-themes-list",
    "allow-desk-ready",
    "allow-window-background",
    "allow-host-info",
    "allow-machine-secret-request",
    "allow-machine-secret-submit",
    "allow-machine-secret-cancel"
  ]
}
