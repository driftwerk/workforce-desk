{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "grid",
  "description": "A grid in a window of its own: the commands and plugins its panes use, and none of pairing, setup, removal or reports",
  "windows": [
    "grid-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default",
    "process:allow-restart",
    "allow-hub-connection",
    "allow-local-hub-fetch",
    "allow-local-hub-socket-open",
    "allow-socket-send",
    "allow-socket-ack",
    "allow-socket-close",
    "allow-hub-fetch",
    "allow-hub-socket-open",
    "allow-host-info",
    "allow-settings-load",
    "allow-settings-save",
    "allow-themes-list",
    "allow-hubs-list",
    "allow-login-start",
    "allow-login-code",
    "allow-login-cancel",
    "allow-cli-installed",
    "allow-cli-install",
    "allow-updating",
    "allow-resume-later",
    "allow-resume-take",
    "allow-desk-state-load",
    "allow-desk-state-put",
    "allow-desk-state-remove",
    "allow-desk-state-synced",
    "allow-desk-state-adopt",
    "allow-desk-state-flush",
    "allow-desk-ready",
    "allow-claude-plugin-dir",
    "allow-backend-home",
    "allow-programs-under",
    "allow-grid-window-open",
    "allow-grid-window-close",
    "allow-grid-windows-open",
    "allow-grid-window-mode",
    "allow-grid-window-monitor",
    "allow-grid-monitors",
    "allow-attachment-open",
    "allow-attachment-save",
    "allow-attachment-upload",
    "allow-voice-enable",
    "allow-voice-disable",
    "allow-voice-claim",
    "allow-voice-set-roster",
    "allow-voice-push-to-talk",
    "allow-voice-speak",
    "allow-voice-stop-speaking",
    "allow-voice-tool-result",
    "allow-voice-try",
    "allow-voice-kokoro-voices",
    "allow-voice-engine-voices",
    "allow-voice-lookup",
    "allow-voice-status"
  ]
}
