{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: every command, and the plugins it uses",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "updater:default",
    "process:allow-restart",
    "process:allow-exit",
    "allow-hub-connection",
    "allow-local-hub-fetch",
    "allow-local-hub-socket-open",
    "allow-socket-send",
    "allow-socket-ack",
    "allow-socket-close",
    "allow-hub-fetch",
    "allow-hub-socket-open",
    "allow-pair-request",
    "allow-pair-collect",
    "allow-fonts-list",
    "allow-host-info",
    "allow-set-unread-badge",
    "allow-settings-load",
    "allow-settings-save",
    "allow-themes-list",
    "allow-themes-write",
    "allow-themes-reveal",
    "allow-hubs-list",
    "allow-hubs-remove",
    "allow-tuple-enable",
    "allow-tuple-disable",
    "allow-tuple-reply",
    "allow-tuple-available",
    "allow-login-start",
    "allow-login-code",
    "allow-login-cancel",
    "allow-helper-status",
    "allow-helper-open-login-items",
    "allow-cli-installed",
    "allow-cli-install",
    "allow-report-save",
    "allow-data-remove",
    "allow-updating",
    "allow-resume-later",
    "allow-resume-take",
    "allow-desk-state-load",
    "allow-desk-state-put",
    "allow-desk-state-remove",
    "allow-desk-state-synced",
    "allow-desk-state-adopt",
    "allow-desk-state-flush",
    "allow-desk-ready",
    "allow-claude-plugin-dir",
    "allow-backend-home",
    "allow-pick-folder",
    "allow-programs-under",
    "allow-grid-window-open",
    "allow-grid-window-close",
    "allow-grid-windows-open",
    "allow-grid-window-mode",
    "allow-grid-window-monitor",
    "allow-grid-monitors",
    "allow-attachment-open",
    "allow-attachment-save",
    "allow-attachment-upload",
    "allow-voice-enable",
    "allow-voice-disable",
    "allow-voice-claim",
    "allow-voice-set-roster",
    "allow-voice-push-to-talk",
    "allow-voice-speak",
    "allow-voice-stop-speaking",
    "allow-voice-tool-result",
    "allow-voice-try",
    "allow-voice-kokoro-voices",
    "allow-voice-engine-voices",
    "allow-voice-lookup",
    "allow-voice-status",
    "allow-wsl-detect",
    "allow-wsl-install",
    "allow-wsl-convert",
    "allow-wsl-setup",
    "allow-wsl-fix-forwarding",
    "allow-wsl-installed"
  ]
}
