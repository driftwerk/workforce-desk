{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: every command, and the plugins it uses",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://*"
        },
        {
          "url": "mailto:*"
        }
      ]
    },
    "notification:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "process:allow-restart",
    "process:allow-exit",
    "allow-hub-connection",
    "allow-local-hub-fetch",
    "allow-local-hub-socket-open",
    "allow-machine-fetch",
    "allow-open-terminal-link",
    "allow-machine-socket-open",
    "allow-machines-list",
    "allow-machine-probe",
    "allow-machine-trust",
    "allow-machine-public-key",
    "allow-machine-add",
    "allow-machine-reconnect",
    "allow-machine-remove",
    "allow-machine-share-accounts",
    "allow-machine-log",
    "allow-machine-remote-log",
    "allow-machine-ssh-hosts",
    "allow-machine-edit",
    "allow-machine-check-reach",
    "allow-machine-cancel-add",
    "allow-machine-retry-engines",
    "allow-machine-cancel-update",
    "allow-machine-uninstall",
    "allow-machine-cancel-uninstall",
    "allow-machine-reveal-log",
    "allow-machine-sign-in-forward",
    "allow-machine-sign-in-forward-stop",
    "allow-machine-open-sign-in-page",
    "allow-socket-send",
    "allow-socket-ack",
    "allow-socket-close",
    "allow-hub-fetch",
    "allow-hub-socket-open",
    "allow-board-sync-mint",
    "allow-pair-request",
    "allow-pair-collect",
    "allow-fonts-list",
    "allow-host-info",
    "allow-set-unread-badge",
    "allow-settings-load",
    "allow-settings-save",
    "allow-themes-list",
    "allow-themes-write",
    "allow-themes-reveal",
    "allow-hubs-list",
    "allow-hubs-remove",
    "allow-tuple-enable",
    "allow-tuple-disable",
    "allow-tuple-reply",
    "allow-tuple-available",
    "allow-login-start",
    "allow-login-code",
    "allow-login-cancel",
    "allow-helper-status",
    "allow-helper-open-login-items",
    "allow-helper-start",
    "allow-helper-last-reason",
    "allow-cli-installed",
    "allow-cli-install",
    "allow-report-save",
    "allow-data-remove",
    "allow-updating",
    "allow-update-check",
    "allow-update-download",
    "allow-update-install",
    "allow-resume-later",
    "allow-resume-take",
    "allow-desk-state-load",
    "allow-desk-state-put",
    "allow-desk-state-remove",
    "allow-desk-state-synced",
    "allow-desk-state-adopt",
    "allow-desk-state-flush",
    "allow-desk-ready",
    "allow-window-background",
    "allow-claude-plugin-dir",
    "allow-machine-home",
    "allow-backend-home",
    "allow-pick-folder",
    "allow-programs-under",
    "allow-repo-facts",
    "allow-grid-window-open",
    "allow-grid-window-close",
    "allow-grid-windows-open",
